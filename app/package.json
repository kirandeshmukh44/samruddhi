{
  "name": "bilu-erp",
  "version": "1.0.0",
  "description": "BiLU ERP – Everything Your Business Needs. Powered by Pravara Infotech Pvt. Ltd.",
  "author": "Pravara Infotech Pvt. Ltd.",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "axios": "^1.21.0",
    "expo": "~58.0.22",
    "expo-constants": "~58.0.14",
    "expo-font": "~58.0.11",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.29",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-web-browser": "~58.0.7",
    "i18next": "^26.7.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.1.11",
    "react-native": "0.88.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "npx expo export -p web",
    "build:apk": "npx eas build -p android --profile preview",
    "build:ios": "npx eas build -p ios --profile preview",
    "run:electron": "electron electron-main.js",
    "dist:win": "electron-builder --win",
    "dist:win:portable": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.pravarainfotech.biluerp",
    "productName": "BiLU ERP",
    "copyright": "Copyright © 2026 Pravara Infotech Pvt. Ltd.",
    "nodeGypRebuild": false,
    "npmRebuild": false,
    "extraMetadata": {
      "main": "electron-main.js",
      "dependencies": {}
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron-main.js",
      "assets/images/bilu-badge.png",
      "!node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/images/bilu-badge.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BiLU ERP"
    }
  },
  "private": true
}
